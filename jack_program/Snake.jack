/** Represents the snake as a linked list of segments. */
class Snake {
    field Array x, y;    // coordinates of each segment
    field int length;     // current length
    field int maxLength;  // max capacity
    field int size;       // pixel size of each segment

    constructor Snake new(int startX, int startY, int segSize) {
        let size = segSize;
        let maxLength = 128;
        let length = 3;
        let x = Array.new(maxLength);
        let y = Array.new(maxLength);

        // Initial snake: 3 segments going right
        let x[0] = startX;
        let y[0] = startY;
        let x[1] = startX - size;
        let y[1] = startY;
        let x[2] = startX - (size + size);
        let y[2] = startY;

        do draw();
        return this;
    }

    method void dispose() {
        do x.dispose();
        do y.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        var int i;
        let i = 0;
        while (i < length) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x[i], y[i], x[i] + size - 1, y[i] + size - 1);
            let i = i + 1;
        }
        return;
    }

    /** Move the snake in direction (dx, dy). Returns true if grew. */
    method boolean move(int dx, int dy, boolean grow) {
        var int i;
        var int newX, newY;

        let newX = x[0] + (dx * size);
        let newY = y[0] + (dy * size);

        // Erase tail if not growing
        if (~grow) {
            do Screen.setColor(false);
            do Screen.drawRectangle(
                x[length - 1], y[length - 1],
                x[length - 1] + size - 1, y[length - 1] + size - 1
            );
        }

        // Shift body segments backward
        if (grow & (length < maxLength)) {
            let length = length + 1;
        }

        let i = length - 1;
        while (i > 0) {
            let x[i] = x[i - 1];
            let y[i] = y[i - 1];
            let i = i - 1;
        }

        // New head
        let x[0] = newX;
        let y[0] = newY;

        // Draw head
        do Screen.setColor(true);
        do Screen.drawRectangle(x[0], y[0], x[0] + size - 1, y[0] + size - 1);

        return grow;
    }

    method int headX() { return x[0]; }
    method int headY() { return y[0]; }
    method int getLength() { return length; }

    /** Check if head collides with body. */
    method boolean collidesWithSelf() {
        var int i;
        let i = 1;
        while (i < length) {
            if ((x[0] = x[i]) & (y[0] = y[i])) {
                return true;
            }
            let i = i + 1;
        }
        return false;
    }
}
