/** Keyboard input library.
    The keyboard memory map is at RAM[24576]. */
class Keyboard {

    /** Initializes the Keyboard. */
    function void init() {
        return;
    }

    /** Returns the character of the currently pressed key (0 if none). */
    function char keyPressed() {
        return Memory.peek(24576);
    }

    /** Waits until a key is pressed, then released, and returns the key. */
    function char readChar() {
        var char key, c;

        // Wait for key press
        while (Keyboard.keyPressed() = 0) {}
        let c = Keyboard.keyPressed();

        // Wait for key release
        while (~(Keyboard.keyPressed() = 0)) {}

        do Output.printChar(c);
        return c;
    }

    /** Reads a line from the keyboard until newline, displaying input. */
    function String readLine(String message) {
        var String line;
        var char c;

        do Output.printString(message);
        let line = String.new(64);

        while (true) {
            let c = Keyboard.readChar();
            if (c = 128) {       // newline
                do Output.println();
                return line;
            }
            if (c = 129) {       // backspace
                do line.eraseLastChar();
            } else {
                do line.appendChar(c);
            }
        }
        return line;
    }

    /** Reads an integer from the keyboard, displaying input. */
    function int readInt(String message) {
        var String line;
        var int val;

        let line = Keyboard.readLine(message);
        let val = line.intValue();
        do line.dispose();
        return val;
    }
}
